<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Register | <%= e(settings.website_title || 'My Portfolio') %></title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<% if (settings.favicon) { %>
<link class="js-favicon" rel="icon" href="/uploads/logo/<%= e(settings.favicon) %>">
<% } %>
<style>
  :root {
    --primary: #6366f1;
    --primary-dark: #4f46e5;
    --gradient: linear-gradient(135deg,#6366f1,#8b5cf6,#06b6d4);
  }
  * { box-sizing: border-box; }
  body {
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    background: #0f0f23;
    position: relative;
    overflow-x: hidden;
    overflow-y: auto;
    margin: 0; padding: 30px 15px;
  }
  body::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 30% 40%, rgba(99,102,241,.3) 0%, transparent 50%),
                radial-gradient(circle at 70% 70%, rgba(139,92,246,.2) 0%, transparent 50%);
    z-index: 0;
  }
  .particles { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .particle {
    position: absolute;
    border-radius: 50%;
    background: rgba(99,102,241,.15);
    animation: floatUp linear infinite;
  }
  @keyframes floatUp {
    0%   { transform: translateY(100vh) scale(0); opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { transform: translateY(-10vh) scale(1); opacity: 0; }
  }
  .register-card {
    position: relative; z-index: 1;
    background: rgba(255,255,255,.05);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 24px;
    padding: 32px 32px;
    width: 100%; max-width: 450px;
    box-shadow: 0 25px 60px rgba(0,0,0,.4);
    animation: slideUp .6s ease-out;
    margin: auto;
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .register-logo {
    width: 56px; height: 56px;
    background: var(--gradient);
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; color: white;
    margin: 0 auto 16px;
    box-shadow: 0 10px 28px rgba(99,102,241,.5);
  }
  .register-title {
    text-align: center; color: #fff;
    font-size: 1.5rem; font-weight: 800; margin-bottom: 4px;
  }
  .register-sub {
    text-align: center; color: #94a3b8;
    font-size: 0.85rem; margin-bottom: 20px;
  }
  .form-label {
    color: #94a3b8; font-size: 0.8rem;
    font-weight: 600; letter-spacing: 0.8px; text-transform: uppercase;
    margin-bottom: 6px;
  }
  .form-control {
    background: rgba(255,255,255,.07) !important;
    border: 1px solid rgba(255,255,255,.12) !important;
    border-radius: 12px !important;
    color: #f1f5f9 !important;
    padding: 13px 16px !important;
    font-size: 0.95rem;
    transition: all .25s;
  }
  .form-control:focus {
    background: rgba(255,255,255,.1) !important;
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 3px rgba(99,102,241,.25) !important;
    color: #fff !important;
  }
  .form-control::placeholder { color: #475569 !important; }
  .form-control.is-invalid {
    border-color: rgba(239,68,68,.6) !important;
    box-shadow: 0 0 0 3px rgba(239,68,68,.15) !important;
  }
  .input-group-text {
    background: rgba(255,255,255,.07) !important;
    border: 1px solid rgba(255,255,255,.12) !important;
    border-right: none !important;
    color: #64748b;
    border-radius: 12px 0 0 12px !important;
  }
  .input-group .form-control { border-left: none !important; border-radius: 0 12px 12px 0 !important; }
  .btn-register {
    width: 100%; padding: 14px;
    background: var(--gradient);
    border: none; border-radius: 12px;
    color: white; font-weight: 700; font-size: 1rem;
    cursor: pointer; transition: all .3s;
    box-shadow: 0 8px 24px rgba(99,102,241,.4);
    margin-top: 8px;
  }
  .btn-register:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(99,102,241,.55); }
  .btn-register:active { transform: translateY(0); }
  .alert-error {
    background: rgba(239,68,68,.15);
    border: 1px solid rgba(239,68,68,.3);
    color: #fca5a5;
    border-radius: 12px; padding: 12px 16px;
    font-size: 0.875rem; margin-bottom: 20px;
    display: flex; align-items: center; gap: 8px;
  }
  .alert-success {
    background: rgba(34,197,94,.12);
    border: 1px solid rgba(34,197,94,.3);
    color: #86efac;
    border-radius: 12px; padding: 16px;
    font-size: 0.9rem; margin-bottom: 20px;
    text-align: center;
  }
  .alert-success a {
    color: #6366f1; font-weight: 700; text-decoration: none;
    transition: color .2s;
  }
  .alert-success a:hover { color: #818cf8; text-decoration: underline; }
  .field-error {
    color: #fca5a5; font-size: 0.8rem; margin-top: 4px;
    display: flex; align-items: center; gap: 4px;
  }
  .toggle-pwd {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    background: none; border: none; color: #64748b; cursor: pointer;
    padding: 4px; z-index: 5;
  }
  .pwd-wrap { position: relative; }
  .auth-footer {
    text-align: center; margin-top: 24px; color: #94a3b8; font-size: 0.9rem;
  }
  .auth-footer a {
    color: #6366f1; font-weight: 600; text-decoration: none;
    transition: color .2s;
  }
  .auth-footer a:hover { color: #818cf8; text-decoration: underline; }
  .pwd-strength { height: 4px; border-radius: 4px; margin-top: 8px; transition: all .3s; background: rgba(255,255,255,.08); overflow: hidden; }
  .pwd-strength-bar { height: 100%; border-radius: 4px; transition: width .3s, background .3s; width: 0; }
  .pwd-strength-text { font-size: 0.7rem; margin-top: 4px; color: #64748b; }
  @media (max-width: 480px) {
    .register-card { padding: 36px 24px; margin: 16px; }
  }
</style>
</head>
<body>

<div class="particles" id="particles"></div>

<div class="register-card">
  <div class="register-logo"><i class="fa-solid fa-user-plus"></i></div>
  <h1 class="register-title">Create Account</h1>
  <p class="register-sub"><%= e(settings.website_title || 'My Portfolio') %> · Join Now</p>

  <% if (success) { %>
  <div class="alert-success">
    <i class="fa-solid fa-circle-check" style="font-size:1.4rem;color:#22c55e;"></i><br>
    <strong>Registration successful!</strong><br>
    Your account has been created. You can now
    <a href="/login">sign in here</a>.
  </div>
  <% } %>

  <% if (errors.general) { %>
  <div class="alert-error"><i class="fa-solid fa-circle-exclamation"></i> <%= e(errors.general) %></div>
  <% } %>

  <% if (!success) { %>
  <form method="POST" novalidate id="registerForm">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

    <!-- Name -->
    <div class="mb-3">
      <label class="form-label"><i class="fa-solid fa-user me-1"></i> Full Name</label>
      <div class="input-group">
        <span class="input-group-text"><i class="fa-solid fa-id-card fa-sm"></i></span>
        <input type="text" class="form-control <%= errors.name ? 'is-invalid' : '' %>"
               name="name" value="<%= e(name) %>"
               placeholder="Enter your full name" required autofocus autocomplete="name">
      </div>
      <% if (errors.name) { %>
      <div class="field-error"><i class="fa-solid fa-triangle-exclamation fa-xs"></i> <%= e(errors.name) %></div>
      <% } %>
    </div>

    <!-- Email -->
    <div class="mb-3">
      <label class="form-label"><i class="fa-solid fa-envelope me-1"></i> Email</label>
      <div class="input-group">
        <span class="input-group-text"><i class="fa-solid fa-at fa-sm"></i></span>
        <input type="email" class="form-control <%= errors.email ? 'is-invalid' : '' %>"
               name="email" value="<%= e(email) %>"
               placeholder="Enter your email" required autocomplete="email">
      </div>
      <% if (errors.email) { %>
      <div class="field-error"><i class="fa-solid fa-triangle-exclamation fa-xs"></i> <%= e(errors.email) %></div>
      <% } %>
    </div>

    <!-- Password -->
    <div class="mb-3">
      <label class="form-label"><i class="fa-solid fa-lock me-1"></i> Password</label>
      <div class="pwd-wrap">
        <input type="password" class="form-control <%= errors.password ? 'is-invalid' : '' %>"
               name="password" id="pwdField" placeholder="Min 6 characters" required>
        <button type="button" class="toggle-pwd" onclick="togglePwd('pwdField', 'eyeIcon')" id="eyeBtn">
          <i class="fa-solid fa-eye fa-sm" id="eyeIcon"></i>
        </button>
      </div>
      <div class="pwd-strength"><div class="pwd-strength-bar" id="strengthBar"></div></div>
      <div class="pwd-strength-text" id="strengthText">Strength: Weak</div>
      <% if (errors.password) { %>
      <div class="field-error"><i class="fa-solid fa-triangle-exclamation fa-xs"></i> <%= e(errors.password) %></div>
      <% } %>
    </div>

    <!-- Confirm Password -->
    <div class="mb-3">
      <label class="form-label"><i class="fa-solid fa-circle-check me-1"></i> Confirm Password</label>
      <div class="pwd-wrap">
        <input type="password" class="form-control <%= errors.confirm_password ? 'is-invalid' : '' %>"
               name="confirm_password" id="confirmPwdField" placeholder="Re-enter password" required>
        <button type="button" class="toggle-pwd" onclick="togglePwd('confirmPwdField', 'eyeIconConfirm')" id="eyeBtnConfirm">
          <i class="fa-solid fa-eye fa-sm" id="eyeIconConfirm"></i>
        </button>
      </div>
      <% if (errors.confirm_password) { %>
      <div class="field-error"><i class="fa-solid fa-triangle-exclamation fa-xs"></i> <%= e(errors.confirm_password) %></div>
      <% } %>
    </div>

    <button type="submit" class="btn-register">
      <i class="fa-solid fa-user-plus me-2"></i> Register Account
    </button>
  </form>
  <% } %>

  <p class="auth-footer">Already have an account? <a href="/login">Sign In</a></p>
</div>

<script>
function togglePwd(fieldId, iconId) {
  const f = document.getElementById(fieldId);
  const i = document.getElementById(iconId);
  if (f.type === 'password') {
    f.type = 'text';
    i.className = 'fa-solid fa-eye-slash fa-sm';
  } else {
    f.type = 'password';
    i.className = 'fa-solid fa-eye fa-sm';
  }
}

// Particle background logic
function createParticles() {
  const container = document.getElementById('particles');
  if(!container) return;
  const count = 30;
  for(let i=0; i<count; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    const size = Math.random() * 8 + 4;
    p.style.width = size + 'px';
    p.style.height = size + 'px';
    p.style.left = Math.random() * 100 + 'vw';
    p.style.animationDuration = Math.random() * 6 + 6 + 's';
    p.style.animationDelay = Math.random() * -10 + 's';
    container.appendChild(p);
  }
}
createParticles();

// Real-time password strength indicator
const pwd = document.getElementById('pwdField');
if (pwd) {
  pwd.addEventListener('input', function() {
    const val = this.value;
    const bar = document.getElementById('strengthBar');
    const txt = document.getElementById('strengthText');
    let strength = 0;
    if (val.length >= 6) strength += 25;
    if (/[a-z]/.test(val) && /[A-Z]/.test(val)) strength += 25;
    if (/[0-9]/.test(val)) strength += 25;
    if (/[^a-zA-Z0-9]/.test(val)) strength += 25;

    bar.style.width = strength + '%';
    if(strength <= 25) {
      bar.style.backgroundColor = '#ef4444';
      txt.textContent = 'Strength: Weak';
    } else if(strength <= 75) {
      bar.style.backgroundColor = '#f59e0b';
      txt.textContent = 'Strength: Moderate';
    } else {
      bar.style.backgroundColor = '#10b981';
      txt.textContent = 'Strength: Strong';
    }
  });
}
</script>
</body>
</html>
