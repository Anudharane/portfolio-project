<%
const base_url = typeof baseUrl !== 'undefined' ? baseUrl : '';
const footerText = (typeof settings !== 'undefined' && settings.footer_text) ? settings.footer_text : 'All Rights Reserved.';
const siteTitle = (typeof settings !== 'undefined' && settings.website_title) ? settings.website_title : 'My Portfolio';
const heroName = (typeof hero !== 'undefined' && hero.name) ? hero.name : '';
const soc = typeof social !== 'undefined' && social ? social : {};
%>
<footer class="site-footer" id="footer">
  <div class="container">
    <div class="row gy-4">
      <!-- Brand col -->
      <div class="col-lg-4">
        <div class="footer-brand mb-3">
          <div class="brand-icon-sm"><i class="fa-solid fa-code"></i></div>
          <span><%= siteTitle %></span>
        </div>
        <p class="footer-desc">
          <%= heroName ? 'Portfolio of ' + heroName + '.' : 'A professional portfolio website.' %>
          Built with passion and attention to detail.
        </p>
      </div>
      <!-- Quick Links -->
      <div class="col-6 col-lg-2 offset-lg-1">
        <h6 class="footer-heading">Quick Links</h6>
        <ul class="footer-links">
          <li><a href="#home"><i class="fa-solid fa-chevron-right fa-xs me-1"></i>Home</a></li>
          <li><a href="#about"><i class="fa-solid fa-chevron-right fa-xs me-1"></i>About</a></li>
          <li><a href="#skills"><i class="fa-solid fa-chevron-right fa-xs me-1"></i>Skills</a></li>
          <li><a href="#projects"><i class="fa-solid fa-chevron-right fa-xs me-1"></i>Projects</a></li>
          <li><a href="#contact"><i class="fa-solid fa-chevron-right fa-xs me-1"></i>Contact</a></li>
        </ul>
      </div>
      <!-- More Links -->
      <div class="col-6 col-lg-2">
        <h6 class="footer-heading">More</h6>
        <ul class="footer-links">
          <li><a href="#education"><i class="fa-solid fa-chevron-right fa-xs me-1"></i>Education</a></li>
          <li><a href="#experience"><i class="fa-solid fa-chevron-right fa-xs me-1"></i>Experience</a></li>
          <li><a href="#certificates"><i class="fa-solid fa-chevron-right fa-xs me-1"></i>Certificates</a></li>
          <li><a href="#services"><i class="fa-solid fa-chevron-right fa-xs me-1"></i>Services</a></li>
        </ul>
      </div>
      <!-- Social -->
      <div class="col-lg-3">
        <h6 class="footer-heading">Follow Me</h6>
        <div class="social-icons">
          <% if (soc.github) { %>
          <a href="<%= soc.github %>" target="_blank" rel="noopener" class="social-icon" title="GitHub">
            <i class="fa-brands fa-github"></i></a>
          <% } %>
          <% if (soc.linkedin) { %>
          <a href="<%= soc.linkedin %>" target="_blank" rel="noopener" class="social-icon" title="LinkedIn">
            <i class="fa-brands fa-linkedin-in"></i></a>
          <% } %>
          <% if (soc.instagram) { %>
          <a href="<%= soc.instagram %>" target="_blank" rel="noopener" class="social-icon" title="Instagram">
            <i class="fa-brands fa-instagram"></i></a>
          <% } %>
          <% if (soc.twitter) { %>
          <a href="<%= soc.twitter %>" target="_blank" rel="noopener" class="social-icon" title="Twitter/X">
            <i class="fa-brands fa-x-twitter"></i></a>
          <% } %>
          <% if (soc.facebook) { %>
          <a href="<%= soc.facebook %>" target="_blank" rel="noopener" class="social-icon" title="Facebook">
            <i class="fa-brands fa-facebook-f"></i></a>
          <% } %>
          <% if (soc.youtube) { %>
          <a href="<%= soc.youtube %>" target="_blank" rel="noopener" class="social-icon" title="YouTube">
            <i class="fa-brands fa-youtube"></i></a>
          <% } %>
        </div>
        <% if (typeof hero !== 'undefined' && hero && hero.resume) { %>
        <a href="<%= base_url %>/uploads/resumes/<%= hero.resume %>" target="_blank"
           class="btn-primary-grad mt-4" style="width:100%;justify-content:center;">
           <i class="fa-solid fa-download"></i> Download Resume
        </a>
        <% } %>
      </div>
    </div>

    <hr class="footer-divider">

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; <%= new Date().getFullYear() %> <strong style="color:#6366f1"><%= siteTitle %></strong>.
        <%= footerText %>
      </p>
      <p class="footer-copy">
        Made with <i class="fa-solid fa-heart" style="color:#ef4444"></i> using PHP &amp; Bootstrap 5
      </p>
    </div>
  </div>
</footer>

<!-- Back to Top -->
<button class="back-to-top" id="backToTop" title="Back to top">
  <i class="fa-solid fa-chevron-up"></i>
</button>

<!-- Bootstrap 5 -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- AOS -->
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<!-- Typed.js -->
<script src="https://cdn.jsdelivr.net/npm/typed.js@2.1.0/dist/typed.umd.js"></script>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<!-- Custom JS -->
<script src="<%= base_url %>/assets/js/main.js"></script>
