<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Login | <%= e(settings.website_title || 'My Portfolio') %></title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<% if (settings.favicon) { %>
<link rel="icon" href="/uploads/logo/<%= e(settings.favicon) %>">
<% } %>
<style>
  :root {
    --primary: #6366f1;
    --primary-dark: #4f46e5;
    --gradient: linear-gradient(135deg,#6366f1,#8b5cf6,#06b6d4);
  }
  * { box-sizing: border-box; }
  body {
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    background: #0f0f23;
    position: relative;
    overflow-x: hidden;
    overflow-y: auto;
    margin: 0; padding: 30px 15px;
  }
  body::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 30% 40%, rgba(99,102,241,.3) 0%, transparent 50%),
                radial-gradient(circle at 70% 70%, rgba(139,92,246,.2) 0%, transparent 50%);
    z-index: 0;
  }
  .login-card {
    position: relative; z-index: 1;
    background: rgba(255,255,255,.05);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 24px;
    padding: 50px 44px;
    width: 100%; max-width: 440px;
    box-shadow: 0 25px 60px rgba(0,0,0,.4);
  }
  .login-logo {
    width: 64px; height: 64px;
    background: var(--gradient);
    border-radius: 18px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem; color: white;
    margin: 0 auto 22px;
    box-shadow: 0 10px 28px rgba(99,102,241,.5);
  }
  .login-title {
    text-align: center; color: #fff;
    font-size: 1.6rem; font-weight: 800; margin-bottom: 6px;
  }
  .login-sub {
    text-align: center; color: #94a3b8;
    font-size: 0.875rem; margin-bottom: 32px;
  }
  .form-label {
    color: #94a3b8; font-size: 0.8rem;
    font-weight: 600; letter-spacing: 0.8px; text-transform: uppercase;
    margin-bottom: 6px;
  }
  .form-control {
    background: rgba(255,255,255,.07) !important;
    border: 1px solid rgba(255,255,255,.12) !important;
    border-radius: 12px !important;
    color: #f1f5f9 !important;
    padding: 13px 16px !important;
    font-size: 0.95rem;
    transition: all .25s;
  }
  .form-control:focus {
    background: rgba(255,255,255,.1) !important;
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 3px rgba(99,102,241,.25) !important;
    color: #fff !important;
  }
  .form-control::placeholder { color: #475569 !important; }
  .input-group-text {
    background: rgba(255,255,255,.07) !important;
    border: 1px solid rgba(255,255,255,.12) !important;
    border-right: none !important;
    color: #64748b;
    border-radius: 12px 0 0 12px !important;
  }
  .input-group .form-control { border-left: none !important; border-radius: 0 12px 12px 0 !important; }
  .btn-login {
    width: 100%; padding: 14px;
    background: var(--gradient);
    border: none; border-radius: 12px;
    color: white; font-weight: 700; font-size: 1rem;
    cursor: pointer; transition: all .3s;
    box-shadow: 0 8px 24px rgba(99,102,241,.4);
    margin-top: 8px;
  }
  .btn-login:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(99,102,241,.55); }
  .btn-login:active { transform: translateY(0); }
  .alert-login {
    background: rgba(239,68,68,.15);
    border: 1px solid rgba(239,68,68,.3);
    color: #fca5a5;
    border-radius: 12px; padding: 12px 16px;
    font-size: 0.875rem; margin-bottom: 20px;
    display: flex; align-items: center; gap: 8px;
  }
  .toggle-pwd {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    background: none; border: none; color: #64748b; cursor: pointer;
    padding: 4px; z-index: 5;
  }
  .pwd-wrap { position: relative; }
  .hint {
    text-align: center; margin-top: 24px; color: #475569; font-size: 0.8rem;
  }
  .hint code {
    background: rgba(255,255,255,.08); padding: 2px 8px; border-radius: 6px;
    color: #a5b4fc; font-size: 0.85rem;
  }
  @media (max-width: 480px) {
    .login-card { padding: 36px 24px; margin: 16px; }
  }
</style>
</head>
<body>
<div class="login-card">
  <div class="login-logo"><i class="fa-solid fa-code"></i></div>
  <h1 class="login-title">Admin Login</h1>
  <p class="login-sub"><%= e(settings.website_title || 'My Portfolio') %> · Dashboard</p>

  <% if (flash) { %>
  <div class="alert-login alert-<%= flash.type %>">
    <i class="fa-solid fa-circle-info"></i> <%= flash.msg %>
  </div>
  <% } %>

  <% if (error) { %>
  <div class="alert-login"><i class="fa-solid fa-circle-exclamation"></i> <%= e(error) %></div>
  <% } %>

  <form method="POST" novalidate>
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

    <div class="mb-4">
      <label class="form-label"><i class="fa-solid fa-user me-1"></i> Username or Email</label>
      <div class="input-group">
        <span class="input-group-text"><i class="fa-solid fa-at fa-sm"></i></span>
        <input type="text" class="form-control" name="username"
               placeholder="Enter username or email" required autofocus autocomplete="username">
      </div>
    </div>

    <div class="mb-4">
      <label class="form-label"><i class="fa-solid fa-lock me-1"></i> Password</label>
      <div class="pwd-wrap">
        <input type="password" class="form-control" name="password" id="pwdField"
               placeholder="Enter password" required autocomplete="current-password">
        <button type="button" class="toggle-pwd" onclick="togglePwd()" id="eyeBtn">
          <i class="fa-solid fa-eye fa-sm" id="eyeIcon"></i>
        </button>
      </div>
    </div>

    <button type="submit" class="btn-login">
      <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In
    </button>
  </form>


  <p style="text-align:center;margin-top:16px;color:#94a3b8;font-size:.9rem;">
    Don't have an account? <a href="/register" style="color:#6366f1;font-weight:600;text-decoration:none;">Create Account</a>
  </p>
</div>

<script>
function togglePwd() {
  const f = document.getElementById('pwdField');
  const i = document.getElementById('eyeIcon');
  if (f.type === 'password') {
    f.type = 'text';
    i.className = 'fa-solid fa-eye-slash fa-sm';
  } else {
    f.type = 'password';
    i.className = 'fa-solid fa-eye fa-sm';
  }
}
</script>
</body>
</html>
