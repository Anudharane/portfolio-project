<%- include('header') %>

<div class="card shadow-sm">
  <div class="card-body">
    <h6 class="card-title mb-4"><i class="fa-brands fa-share-nodes me-2 text-primary"></i>Manage Social Media Links</h6>
    <form method="POST" action="/admin/add_social" class="row g-3">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

      <% 
      const fields = [
          { name: 'github', label: 'GitHub', icon: 'fa-brands fa-github', placeholder: 'https://github.com/username' },
          { name: 'linkedin', label: 'LinkedIn', icon: 'fa-brands fa-linkedin', placeholder: 'https://linkedin.com/in/username' },
          { name: 'instagram', label: 'Instagram', icon: 'fa-brands fa-instagram', placeholder: 'https://instagram.com/username' },
          { name: 'twitter', label: 'Twitter / X', icon: 'fa-brands fa-x-twitter', placeholder: 'https://x.com/username' },
          { name: 'facebook', label: 'Facebook', icon: 'fa-brands fa-facebook', placeholder: 'https://facebook.com/username' },
          { name: 'youtube', label: 'YouTube', icon: 'fa-brands fa-youtube', placeholder: 'https://youtube.com/@channel' }
      ];
      fields.forEach(f => {
      %>
      <div class="col-md-6">
        <label class="form-label"><i class="<%= f.icon %> me-1"></i> <%= f.label %></label>
        <input type="url" name="<%= f.name %>" class="form-control"
               placeholder="<%= f.placeholder %>" value="<%= e(social[f.name] || '') %>">
      </div>
      <% }); %>

      <div class="col-12 mt-4">
        <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-floppy-disk me-1"></i> Save Social Links</button>
      </div>
    </form>
  </div>
</div>

<%- include('footer') %>
