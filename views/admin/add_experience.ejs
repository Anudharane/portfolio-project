<%- include('header') %>

<div class="row g-3">
  <div class="col-lg-5">
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="card-title mb-3">
          <i class="fa-solid fa-briefcase me-2 text-primary"></i>
          <%= editRow ? 'Edit Experience' : 'Add Experience' %>
        </h6>
        <form method="POST" action="/admin/add_experience" class="row g-2">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <input type="hidden" name="id" value="<%= editRow ? editRow.id : 0 %>">

          <div class="col-12">
            <label class="form-label">Company *</label>
            <input type="text" name="company" class="form-control" required
                   value="<%= editRow ? e(editRow.company) : '' %>" placeholder="Google LLC">
          </div>
          <div class="col-md-6">
            <label class="form-label">Position *</label>
            <input type="text" name="position" class="form-control" required
                   value="<%= editRow ? e(editRow.position) : '' %>" placeholder="Software Engineer">
          </div>
          <div class="col-md-6">
            <label class="form-label">Duration</label>
            <input type="text" name="duration" class="form-control"
                   value="<%= editRow ? e(editRow.duration) : '' %>"
                   placeholder="Jan 2023 – Present">
          </div>
          <div class="col-12">
            <label class="form-label">Description</label>
            <textarea name="description" rows="4" class="form-control"
                      placeholder="What did you do and achieve..."><%= editRow ? e(editRow.description) : '' %></textarea>
          </div>
          <div class="col-12 mt-1">
            <button type="submit" class="btn btn-primary w-100">
              <i class="fa-solid fa-floppy-disk me-1"></i><%= editRow ? 'Update' : 'Add' %>
            </button>
            <% if (editRow) { %>
            <a href="/admin/add_experience" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
            <% } %>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card shadow-sm">
      <div class="card-body">
        <table class="table table-hover align-middle" id="dataTable">
          <thead>
            <tr><th>#</th><th>Company</th><th>Position</th><th>Duration</th><th class="text-end">Actions</th></tr>
          </thead>
          <tbody>
            <% let idx = 1; experience.forEach(row => { %>
            <tr>
              <td><%= idx++ %></td>
              <td><%= e(row.company) %></td>
              <td><%= e(row.position) %></td>
              <td><small class="text-muted"><%= e(row.duration) %></small></td>
              <td class="text-end">
                <a href="/admin/add_experience?edit=<%= row.id %>"
                   class="btn btn-sm btn-outline-primary me-1">
                  <i class="fa-solid fa-pen"></i>
                </a>
                <a href="/admin/add_experience?delete=<%= row.id %>"
                   class="btn btn-sm btn-outline-danger btn-delete"
                   data-label="<%= e(row.position) %>">
                  <i class="fa-solid fa-trash"></i>
                </a>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('footer') %>
